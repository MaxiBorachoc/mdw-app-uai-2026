# Copiar como .env.e2e. Esta base debe ser LOCAL y descartable.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/mdw_e2e?schema=public"
DIRECT_URL="postgresql://postgres:postgres@127.0.0.1:5432/mdw_e2e?schema=public"

# Solo para las sesiones fabricadas por las pruebas. No usar secretos de producción.
AUTH_SECRET="e2e-auth-secret-local-only-12345678901234567890"
AUTH_GOOGLE_ID="e2e-google-id"
AUTH_GOOGLE_SECRET="e2e-google-secret"
AUTH_URL="http://127.0.0.1:3000"
AUTH_TRUST_HOST="true"
APP_URL="http://127.0.0.1:3000"
E2E_BASE_URL="http://127.0.0.1:3000"
