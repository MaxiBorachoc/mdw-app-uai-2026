# Copiar a .env.local y completar. NUNCA commitear .env.local.

# Base de datos. Las dos strings salen del botón "Connect" del panel de Supabase.
#
# DATABASE_URL: pooler en modo Transaction (puerto 6543). Es la que usa la app.
DATABASE_URL="postgresql://usuario:password@host:6543/postgres?pgbouncer=true"
#
# DIRECT_URL: conexión directa (puerto 5432). Solo la usan las migraciones.
DIRECT_URL="postgresql://usuario:password@host:5432/postgres"

# Secreto de sesión. Generar con: npx auth secret
AUTH_SECRET=""

# Credenciales de OAuth de Google (Google Cloud Console → Credenciales).
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# API key de Resend (resend.com → API Keys). La usa lib/servicios/mail.ts,
# el único archivo del proyecto que la lee.
RESEND_API_KEY=""

# URL pública de la app, sin barra al final. Se usa para armar los links de
# los correos (aceptar/rechazar invitación). En Vercel: la URL de producción.
APP_URL="http://localhost:3000"

# Remitente de los correos (opcional). Si falta, se usa el remitente de prueba de
# Resend (onboarding@resend.dev), que solo entrega a la casilla de la cuenta de Resend.
# Con un dominio verificado en Resend: MAIL_REMITENTE="Nombre <avisos@tudominio.com>"
MAIL_REMITENTE=""

# Regla: ninguna variable con un secreto puede llamarse NEXT_PUBLIC_*,
# porque todo lo que lleva ese prefijo queda visible en el navegador.
