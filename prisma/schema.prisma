// Modelo de datos del proyecto: documentacion versionada de proyectos de software.
// Ver docs/spec.md seccion 3 (Entidades) y seccion 6 (Reglas de negocio).
//
// Despues de cualquier cambio en este archivo:
//   npx prisma migrate dev --name <descripcion-del-cambio>

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum RolProyecto {
  OWNER
  EDITOR
  READER
}

enum EstadoVersionProyecto {
  EN_DESARROLLO
  CERRADA
}

// H15: un proyecto en proceso tiene exactamente un build en desarrollo; uno
// finalizado, ninguno (docs/spec.md seccion 6).
enum EstadoProyecto {
  EN_PROCESO
  FINALIZADO
}

// H16: un nodo del lienzo es una actividad o un nodo de control de UML. Los nodos
// de control no tienen nombre, documentacion, historias ni diagrama interno. El
// tipo no cambia despues de crear el nodo (lo controla lib/documentacion.ts).
enum TipoNodo {
  ACTIVIDAD
  INICIAL
  FINAL_ACTIVIDAD
  FINAL_FLUJO
  DECISION
  BIFURCACION
}

enum EstadoInvitacion {
  PENDIENTE
  ACEPTADA
  RECHAZADA
}

// Una persona con cuenta. Se crea (o actualiza el nombre) en el primer login
// con Google, dentro del callback jwt de auth.ts — no hay registro aparte.
model Usuario {
  id       String   @id @default(cuid())
  email    String   @unique
  nombre   String
  creadoEn DateTime @default(now())

  proyectosCreados   Proyecto[]                 @relation("ProyectoCreador")
  membresias         MiembroProyecto[]
  historiaVersiones  HistoriaUsuarioVersion[]
  actividadVersiones ActividadVersion[]
  conexionVersiones  ConexionActividadVersion[]
  carrilVersiones    CarrilVersion[]
}

model Proyecto {
  id          String         @id @default(cuid())
  nombre      String
  descripcion String         @default("")
  creadoEn    DateTime       @default(now())
  estado      EstadoProyecto @default(EN_PROCESO)

  // Definicion del proyecto (H13). No se versiona: guardarla reemplaza la anterior.
  problemaNegocio    String    @default("")
  objetivo           String    @default("")
  limitesExclusiones String[]  @default([])
  fechaInicio        DateTime? @db.Date
  fechaFinEstimada   DateTime? @db.Date

  ownerId String
  owner   Usuario @relation("ProyectoCreador", fields: [ownerId], references: [id], onDelete: Restrict)

  miembros    MiembroProyecto[]
  historias   HistoriaUsuario[]
  actividades Actividad[]
  conexiones  ConexionActividad[]
  carriles    Carril[]
  versiones   VersionProyecto[]
  entregables Entregable[]

  @@index([ownerId])
}

// H14: algo que el proyecto se compromete a entregar. Cada build cerrado apunta a
// uno; un entregable puede tener varios builds (el que lo documenta y los que lo
// corrigen). El estado (pendiente, atrasado...) no se guarda: se calcula.
model Entregable {
  id            String    @id @default(cuid())
  nombre        String
  descripcion   String    @default("")
  fechaEstimada DateTime  @db.Date
  entregado     Boolean   @default(false)
  fechaEntrega  DateTime? @db.Date
  creadoEn      DateTime  @default(now())

  proyectoId String
  proyecto   Proyecto @relation(fields: [proyectoId], references: [id], onDelete: Cascade)

  versiones VersionProyecto[]

  @@index([proyectoId])
}

// Relacion N-N entre Usuario y Proyecto, con dato propio: el rol y el estado de
// la invitacion. Sin @default a proposito: cada lugar que crea una fila (el
// owner al crear el proyecto, o invitarMiembro) tiene que decidir el estado
// explicitamente, para que no quede "aceptada" por accidente (ver clase 7).
model MiembroProyecto {
  id       String           @id @default(cuid())
  rol      RolProyecto
  estado   EstadoInvitacion
  creadoEn DateTime         @default(now())

  usuarioId String
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  proyectoId String
  proyecto   Proyecto @relation(fields: [proyectoId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, proyectoId])
  @@index([proyectoId])
  @@index([usuarioId])
}

// ---------------------------------------------------------------------------
// Elementos versionables: historias, actividades y flechas (docs/spec.md, seccion 3).
//
// Cada tipo tiene dos tablas:
//   - la identidad (solo id y proyecto): no cambia nunca y es el destino de las
//     claves foraneas, para que la base impida referencias rotas;
//   - las revisiones: una fila por cada cambio confirmado, inmutable. Toda revision
//     guarda numeroVersion (version del elemento), versionProyectoId (el build en
//     el que se confirmo), eliminado, autor y fecha, ademas de sus datos propios.
//
// Las referencias entre elementos (padre, origen, destino, historias asociadas)
// apuntan a la identidad, no a una revision: que revision corresponde se resuelve
// con la regla de reconstruccion de un build (lib/documentacion.ts).
//
// Las referencias cruzadas usan onDelete: NoAction (se verifica al final de la
// sentencia): asi borrar un proyecto, que se lleva en cascada todo lo suyo, no
// choca con el orden en que Postgres borra las filas.
// ---------------------------------------------------------------------------

model HistoriaUsuario {
  id String @id @default(cuid())

  proyectoId String
  proyecto   Proyecto @relation(fields: [proyectoId], references: [id], onDelete: Cascade)

  revisiones   HistoriaUsuarioVersion[]
  asociaciones ActividadVersionHistoria[]

  @@index([proyectoId])
}

model HistoriaUsuarioVersion {
  id                  String   @id @default(cuid())
  numeroVersion       Int
  eliminado           Boolean  @default(false)
  titulo              String
  descripcion         String
  criteriosAceptacion String[]
  creadoEn            DateTime @default(now())

  historiaId String
  historia   HistoriaUsuario @relation(fields: [historiaId], references: [id], onDelete: Cascade)

  versionProyectoId String
  versionProyecto   VersionProyecto @relation(fields: [versionProyectoId], references: [id], onDelete: NoAction)

  autorId String
  autor   Usuario @relation(fields: [autorId], references: [id], onDelete: Restrict)

  @@unique([historiaId, numeroVersion])
  @@index([versionProyectoId])
  @@index([autorId])
}

// Una actividad sin padre es un diagrama; las que tienen padre son los nodos de su
// diagrama interno. La posicion y el padre viven en la revision: al mirar un build
// cerrado, el diagrama se ve exactamente como estaba.
model Actividad {
  id String @id @default(cuid())

  proyectoId String
  proyecto   Proyecto @relation(fields: [proyectoId], references: [id], onDelete: Cascade)

  revisiones        ActividadVersion[]         @relation("ActividadRevisiones")
  revisionesHijas   ActividadVersion[]         @relation("ActividadPadre")
  conexionesOrigen  ConexionActividadVersion[] @relation("ConexionOrigen")
  conexionesDestino ConexionActividadVersion[] @relation("ConexionDestino")
  carriles          CarrilVersion[]

  @@index([proyectoId])
}

model ActividadVersion {
  id            String   @id @default(cuid())
  numeroVersion Int
  eliminado     Boolean  @default(false)
  tipo          TipoNodo @default(ACTIVIDAD)
  nombre        String
  documentacion String   @default("")
  // Nulas en un diagrama (actividad sin padre): no se dibuja en ningun lienzo.
  posicionX     Float?
  posicionY     Float?
  creadoEn      DateTime @default(now())

  actividadId String
  actividad   Actividad @relation("ActividadRevisiones", fields: [actividadId], references: [id], onDelete: Cascade)

  actividadPadreId String?
  actividadPadre   Actividad? @relation("ActividadPadre", fields: [actividadPadreId], references: [id], onDelete: NoAction)

  versionProyectoId String
  versionProyecto   VersionProyecto @relation(fields: [versionProyectoId], references: [id], onDelete: NoAction)

  autorId String
  autor   Usuario @relation(fields: [autorId], references: [id], onDelete: Restrict)

  historias ActividadVersionHistoria[]

  @@unique([actividadId, numeroVersion])
  @@index([actividadPadreId])
  @@index([versionProyectoId])
  @@index([autorId])
}

// Relacion N-N entre una revision de actividad y las historias que implementa.
model ActividadVersionHistoria {
  actividadVersionId String
  actividadVersion   ActividadVersion @relation(fields: [actividadVersionId], references: [id], onDelete: Cascade)

  historiaId String
  historia   HistoriaUsuario @relation(fields: [historiaId], references: [id], onDelete: NoAction)

  @@id([actividadVersionId, historiaId])
  @@index([historiaId])
}

// Flecha entre dos actividades del mismo diagrama. Se versiona como cualquier
// elemento: un build cerrado muestra las flechas que existian en ese momento. La
// unicidad de origen-destino se valida en lib/documentacion.ts sobre las flechas
// vigentes (una eliminada puede volver a crearse).
model ConexionActividad {
  id String @id @default(cuid())

  proyectoId String
  proyecto   Proyecto @relation(fields: [proyectoId], references: [id], onDelete: Cascade)

  revisiones ConexionActividadVersion[]

  @@index([proyectoId])
}

model ConexionActividadVersion {
  id            String   @id @default(cuid())
  numeroVersion Int
  eliminado     Boolean  @default(false)
  // H16: condicion opcional, se muestra entre corchetes sobre la flecha.
  guarda        String   @default("")
  creadoEn      DateTime @default(now())

  conexionId String
  conexion   ConexionActividad @relation(fields: [conexionId], references: [id], onDelete: Cascade)

  actividadOrigenId String
  actividadOrigen   Actividad @relation("ConexionOrigen", fields: [actividadOrigenId], references: [id], onDelete: NoAction)

  actividadDestinoId String
  actividadDestino   Actividad @relation("ConexionDestino", fields: [actividadDestinoId], references: [id], onDelete: NoAction)

  versionProyectoId String
  versionProyecto   VersionProyecto @relation(fields: [versionProyectoId], references: [id], onDelete: NoAction)

  autorId String
  autor   Usuario @relation(fields: [autorId], references: [id], onDelete: Restrict)

  @@unique([conexionId, numeroVersion])
  @@index([actividadOrigenId])
  @@index([actividadDestinoId])
  @@index([versionProyectoId])
  @@index([autorId])
}

// H17: un carril es una franja vertical con nombre en el lienzo de un diagrama. Es
// solo visual: guarda su posicion X y su ancho, y no registra que nodos quedan
// dentro. El diagrama (la actividad cuyo lienzo divide) no cambia entre revisiones;
// el nombre unico por diagrama se valida en lib/documentacion.ts sobre los vigentes.
model Carril {
  id String @id @default(cuid())

  proyectoId String
  proyecto   Proyecto @relation(fields: [proyectoId], references: [id], onDelete: Cascade)

  revisiones CarrilVersion[]

  @@index([proyectoId])
}

model CarrilVersion {
  id            String   @id @default(cuid())
  numeroVersion Int
  eliminado     Boolean  @default(false)
  nombre        String
  posicionX     Float
  ancho         Float
  creadoEn      DateTime @default(now())

  carrilId String
  carril   Carril @relation(fields: [carrilId], references: [id], onDelete: Cascade)

  diagramaId String
  diagrama   Actividad @relation(fields: [diagramaId], references: [id], onDelete: NoAction)

  versionProyectoId String
  versionProyecto   VersionProyecto @relation(fields: [versionProyectoId], references: [id], onDelete: NoAction)

  autorId String
  autor   Usuario @relation(fields: [autorId], references: [id], onDelete: Restrict)

  @@unique([carrilId, numeroVersion])
  @@index([diagramaId])
  @@index([versionProyectoId])
  @@index([autorId])
}

// Un build del proyecto (antes "Checkpoint"). Nace EN_DESARROLLO (sin numero, es
// donde se trabaja) y se "cierra" asignandole Version.Build.Patch. "orden" es el
// numero correlativo del build dentro del proyecto (1, 2, 3...): ordena los builds
// para la regla de reconstruccion. Cerrar no copia nada: el estado del build lo
// definen las revisiones confirmadas hasta el.
//
// Solo puede haber una version EN_DESARROLLO por proyecto (indice unico parcial
// en la migracion un_solo_version_abierta). No tiene autor (docs/spec.md seccion 3).
model VersionProyecto {
  id       String                @id @default(cuid())
  orden    Int
  estado   EstadoVersionProyecto @default(EN_DESARROLLO)
  creadoEn DateTime              @default(now())

  // Nulos mientras esta EN_DESARROLLO; se completan al cerrar.
  numeroVersion Int?
  numeroBuild   Int?
  numeroPatch   Int?
  nombre        String?
  descripcion   String?
  cerradaEl     DateTime?

  // H8: el entregable al que corresponde. Nulo mientras esta EN_DESARROLLO; al
  // cerrar es obligatorio (lo controla lib/db/versiones.ts). NoAction: no se
  // puede borrar un entregable al que apunta un build, y al borrar el proyecto
  // en cascada el chequeo se hace al final de la sentencia (Restrict podria
  // rechazarlo segun el orden en que Postgres borre las filas).
  entregableId String?
  entregable   Entregable? @relation(fields: [entregableId], references: [id], onDelete: NoAction)

  proyectoId String
  proyecto   Proyecto @relation(fields: [proyectoId], references: [id], onDelete: Cascade)

  historiaRevisiones  HistoriaUsuarioVersion[]
  actividadRevisiones ActividadVersion[]
  conexionRevisiones  ConexionActividadVersion[]
  carrilRevisiones    CarrilVersion[]

  @@unique([proyectoId, orden])
  @@unique([proyectoId, numeroVersion, numeroBuild, numeroPatch])
  @@index([proyectoId])
  @@index([entregableId])
}
